{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-overlay",
  "version": "0.2.0",
  "identifier": "com.antigravity.desktopoverlay",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Desktop Overlay HUD",
        "label": "main",
        "width": 750,
        "height": 275,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
