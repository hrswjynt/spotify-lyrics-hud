{
  "name": "spotify-lyrics-hud",
  "version": "0.2.0",
  "description": "A sleek, lightweight desktop karaoke lyrics HUD for Spotify built with Tauri v2, Svelte & Rust.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "tauri": "tauri",
    "build:tauri": "tauri build",
    "dev:tauri": "tauri dev"
  },
  "keywords": [
    "desktop-overlay",
    "wayland",
    "hyprland",
    "win32",
    "layer-shell"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/cli": "^2.2.7",
    "@types/node": "^22.13.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.1",
    "vitest": "^3.0.4"
  }
}
